# Copy to .env for local development. On staging/production, prefer real environment variables
# set in the host/web server (they override .env). Never commit .env or share real values.

# development | staging | production
APP_ENV=development
# Must be 0 on staging/production (the app refuses to start otherwise)
APP_DEBUG=1
# Must be https:// on staging/production
APP_URL=http://localhost:8080
# Set to 1 only behind a reverse proxy / load balancer that sets X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY_HEADERS=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=p2p_rent
DB_USERNAME=root
DB_PASSWORD=

# Email. Development: MAIL_DRIVER=log writes emails to storage/logs/mail.log instead of sending.
# Staging/production: MAIL_DRIVER=smtp with your provider's SMTP details (Postmark, SES, Brevo, Mailgun...).
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls (STARTTLS, port 587) | ssl (port 465) | none
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@rentnreturn.co.uk
MAIL_FROM_NAME=RentNReturn

# SMS for mobile verification. Development: SMS_DRIVER=log writes texts to storage/logs/sms.log.
# Staging/production: SMS_DRIVER=twilio with your Twilio credentials and a UK sender number or Messaging Service SID (MG...).
SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Identity verification provider: none (shows "coming soon") | simulated (DEVELOPMENT ONLY — pass/fail page).
IDENTITY_PROVIDER=none

# Stripe (payments). TEST MODE keys only until Darren signs off — live keys are refused unless PAYMENTS_LIVE_APPROVED=yes.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) from the Stripe dashboard endpoint, or from `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
# RentNReturn commission in basis points (1000 = 10%), and who pays it: owner (deducted) | renter (added on top).
PLATFORM_FEE_BPS=1000
PLATFORM_FEE_PAYER=owner
PAYMENTS_LIVE_APPROVED=

# Rental rules (defaults shown). Payment window is capped at the start of the rental's first day.
BOOKING_PAYMENT_WINDOW_HOURS=24
BOOKING_MAX_RENTAL_DAYS=60
BOOKING_MAX_ADVANCE_DAYS=365

# Logging: debug | info | warning | error. Logs go to storage/logs/app-YYYY-MM-DD.log
LOG_LEVEL=info

# AI listing descriptions (optional — without a key, owners write descriptions themselves): groq | gemini | openai | pipeline
AI_PROVIDER=pipeline
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: OpenAI-compatible gateway URL (default https://api.openai.com/v1)
OPENAI_BASE_URL=
# Per-user AI description limits (protects API spend)
RATE_AI_PER_HOUR=10
RATE_AI_PER_DAY=30
