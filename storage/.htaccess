# Safety net: the web root must be the public/ folder. If a server is mistakenly pointed at the
# project folder instead, refuse everything rather than exposing .env, storage/, src/ or vendor/.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
